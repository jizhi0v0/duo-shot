{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duoshot-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "duoshot",
      // Used by `wrangler dev` and by the test suite, so neither can touch
      // anything that has actually been shared.
      "preview_bucket_name": "duoshot-dev"
    }
  ],

  "vars": {
    // No trailing slash. Every link the API returns is built from this, so a
    // wrong value produces links that 404 while uploads keep succeeding.
    "PUBLIC_BASE": "https://s.example.com",
    "R2_BUCKET_NAME": "duoshot"
  },

  // Secrets, set with `wrangler secret put <NAME>` -- never in this file:
  //   UPLOAD_TOKEN           the only credential the DuoShot client holds
  //   R2_ACCOUNT_ID          \
  //   R2_ACCESS_KEY_ID        > only needed for POST /api/new (presigned PUT)
  //   R2_SECRET_ACCESS_KEY   /
  //
  // The custom domain buys a stable URL on a zone you own -- links that outlive
  // any *.workers.dev subdomain and can be pointed elsewhere later. It buys no
  // caching: measured against the deployed Worker, responses carry no
  // `cf-cache-status` at all, so every range request still reaches R2. See the
  // note in src/serve.ts for why that is the wanted behaviour.
  //
  "routes": [{ "pattern": "s.example.com", "custom_domain": true }]
}
